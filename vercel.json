{
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-protected-resource?doc=authorization-server" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth-protected-resource?doc=authorization-server" },
    { "source": "/api/tools/:tool", "destination": "/api/tools?tool=:tool" },
    { "source": "/oauth/consent", "destination": "/index.html" }
  ]
}
